{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-promotion",
  "applicationCode": "promotion",
  "archetype": "application-http-gateway",
  "profileRoot": "etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "deploymentProfile": {
      "allowed": [
        "standalone",
        "cloud"
      ]
    },
    "environment": {
      "allowed": [
        "development",
        "test",
        "staging",
        "production"
      ]
    }
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "cloud.production",
    "gatewayBind": "127.0.0.1:3900"
  },
  "profileFiles": {
    "standalone.development": "etc/topology/standalone.development.env",
    "standalone.test": "etc/topology/standalone.test.env",
    "standalone.staging": "etc/topology/standalone.staging.env",
    "standalone.production": "etc/topology/standalone.production.env",
    "cloud.development": "etc/topology/cloud.development.env",
    "cloud.test": "etc/topology/cloud.test.env",
    "cloud.staging": "etc/topology/cloud.staging.env",
    "cloud.production": "etc/topology/cloud.production.env"
  },
  "envKeys": {
    "deploymentProfile": "SDKWORK_PROMOTION_DEPLOYMENT_PROFILE",
    "environment": "SDKWORK_PROMOTION_ENVIRONMENT",
    "profileId": "SDKWORK_PROMOTION_PROFILE_ID",
    "standaloneGatewayBind": "SDKWORK_PROMOTION_APPLICATION_PUBLIC_INGRESS_BIND",
    "apiGatewayBaseUrl": "SDKWORK_PROMOTION_PLATFORM_API_GATEWAY_HTTP_URL"
  },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_PROMOTION_APPLICATION_PUBLIC_INGRESS_BIND",
      "httpUrlEnv": "SDKWORK_PROMOTION_APPLICATION_PUBLIC_HTTP_URL"
    },
    "platform.api-gateway": {
      "connectivityPlane": "platform",
      "protocols": [
        "http"
      ],
      "httpUrlEnv": "SDKWORK_PROMOTION_PLATFORM_API_GATEWAY_HTTP_URL"
    }
  },
  "cloudPublicHosts": {
    "application.public-ingress": {
      "httpHost": "promotion.sdkwork.com",
      "environments": {
        "development": {
          "httpHost": "promotion-dev.sdkwork.com"
        },
        "test": {
          "httpHost": "promotion-test.sdkwork.com"
        },
        "staging": {
          "httpHost": "promotion-staging.sdkwork.com"
        }
      }
    },
    "platform.api-gateway": {
      "httpHost": "api.sdkwork.com",
      "environments": {
        "development": {
          "httpHost": "api-dev.sdkwork.com"
        },
        "test": {
          "httpHost": "api-test.sdkwork.com"
        },
        "staging": {
          "httpHost": "api-staging.sdkwork.com"
        }
      }
    }
  },
  "components": {
    "applicationServer": {
      "crate": "sdkwork-api-promotion-assembly",
      "binary": "sdkwork-api-promotion-assembly"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-promotion-assembly",
            "binary": "sdkwork-api-promotion-assembly",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "standalone.test": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-promotion-assembly",
            "binary": "sdkwork-api-promotion-assembly",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "standalone.staging": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-promotion-assembly",
            "binary": "sdkwork-api-promotion-assembly",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "standalone.production": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-promotion-assembly",
            "binary": "sdkwork-api-promotion-assembly",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "cloud.development": {
        "processes": [],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "cloud.test": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-promotion-assembly",
            "binary": "sdkwork-api-promotion-assembly",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "cloud.staging": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-promotion-assembly",
            "binary": "sdkwork-api-promotion-assembly",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "cloud.production": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-promotion-assembly",
            "binary": "sdkwork-api-promotion-assembly",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      }
    }
  }
}
