# cloud.demo — cloud-hosted independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL schema `sdkwork_promotion_demo` (table
# prefix `commerce_`) and a dedicated Redis logical DB index so no cache key collides with another
# shared-redis environment.
SDKWORK_PROMOTION_DEPLOYMENT_PROFILE=cloud
SDKWORK_PROMOTION_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_PROMOTION_PROFILE_ID=cloud.demo
SDKWORK_PROMOTION_APPLICATION_PUBLIC_HTTP_URL=https://promotion-demo.sdkwork.com
SDKWORK_PROMOTION_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
