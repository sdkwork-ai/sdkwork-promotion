# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL schema `sdkwork_promotion_demo` (table
# prefix `commerce_`) and a dedicated Redis logical DB index so that no cache key (rate-limit,
# session, idempotency) ever collides with another shared-redis environment.
SDKWORK_PROMOTION_DEPLOYMENT_PROFILE=standalone
SDKWORK_PROMOTION_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_PROMOTION_PROFILE_ID=standalone.demo
SDKWORK_PROMOTION_APPLICATION_PUBLIC_HTTP_URL=https://promotion-demo.sdkwork.com

